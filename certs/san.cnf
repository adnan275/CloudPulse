[req]
default_bits = 2048
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[dn]
C = IN
ST = Local
L = Campus
O = CN-Team1
CN = app.team1.test

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = app.team1.test
DNS.2 = api.team1.test
DNS.3 = localhost
IP.1 = 127.0.0.1
